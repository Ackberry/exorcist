{
  "name": "exorcist",
  "version": "0.1.0",
  "description": "Scan an npm project's installed dependencies for risky packages. Suspects are judged by a local Gemma model through Ollama.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "exorcist": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ackberry/exorcist.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-executable.js",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome format --write ."
  },
  "dependencies": {
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
